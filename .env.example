# ==============================================================================
# Environment Configuration Template for E-Commerce Data Platform
# ==============================================================================
# Copy this file to .env and customize values according to your local environment.

# Database Configuration (MySQL Data Warehouse)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_pass
MYSQL_DATABASE=ecommerce_dwh
MYSQL_ROOT_PASSWORD=rootpassword

# Pipeline Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Paths (Relative to project root or Absolute)
DATA_DIR=./data
LOG_DIR=./logs

# Apache Spark Settings
SPARK_APP_NAME="EcommerceDataPlatform"
SPARK_MASTER="local[*]"
SPARK_DRIVER_MEMORY="2g"

# Airflow Settings
AIRFLOW_UID=50000
AIRFLOW_HOME=./airflow
